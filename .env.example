# Copy to .env and adjust if needed.
# Matches docker-compose.yml defaults.

DATABASE_URL="postgresql://qi:qi@localhost:5432/qualityinspection?schema=public"

# Signs the login session cookie. Use a long random value in any shared environment.
AUTH_SECRET="replace-with-a-long-random-string"

# Vision classification (gpt-4o-mini). Required before Analyze photo works.
OPENAI_API_KEY=""
